# Copy this file to .env and fill in your values

# Required — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
# CLAUDE_MODEL=claude-sonnet-4-6
# DATABASE_URL=sqlite:///./data/mikro_busway.db

# Auth — optional. Session cookies are DB-backed random tokens (not signed
# by SECRET_KEY), so leaving this at the default has no impact on session
# security; it's kept only as a general-purpose app secret for future use.
# SECRET_KEY=change-me-to-a-random-string
#
# Set to true once the app is served over HTTPS in production (Render).
# Leave false for local http:// development.
# COOKIE_SECURE=true

# Optional — email, sent via the Brevo transactional email API (not SMTP:
# Render's free plan blocks outbound traffic on SMTP ports 25/465/587).
# Required only to use "Email Quotation". Leaving BREVO_API_KEY blank
# disables the feature gracefully (no send attempted).
# Get a free API key at https://app.brevo.com/settings/keys/api — EMAIL_FROM
# must be a sender address verified in Brevo (Senders, Domains & Dedicated
# IPs > Senders).
# BREVO_API_KEY=xkeysib-...
# EMAIL_FROM=you@itmikro.com
